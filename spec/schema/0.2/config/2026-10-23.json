{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exacly.dev/spec/schema/0.2/config/2026-10-23",
  "title": "Exacly Specification 0.2 config document (schema iteration 2026-10-23)",
  "description": "Structure of one config document that follows Exacly Specification 0.2.x: the model boundary, records, relationships and exceptions a project authors, in YAML or JSON (section 9). Config may span several documents; exactly one declares the model boundary. Rules that need the whole model (one model boundary across documents, unresolved references, legal relationship endpoints, duplicate edges, cycles, the section 7 traceability rules) are left to a validator, as section 11 describes.",
  "type": "object",
  "required": [
    "exacly"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "exacly": {
      "type": "string",
      "pattern": "^0\\.2\\.\\d+$",
      "description": "Specification version the document follows (section 3)."
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier, unique within the namespace. A reference to another model includes that model's namespace."
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "text": {
      "type": "string",
      "pattern": "\\S",
      "description": "Non-empty text: at least one non-whitespace character."
    },
    "model": {
      "type": "object",
      "description": "Model boundary and identity (section 3).",
      "required": [
        "namespace",
        "product",
        "owner",
        "scope",
        "environment",
        "review_interval_days"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "namespace": {
          "$ref": "#/$defs/text"
        },
        "product": {
          "$ref": "#/$defs/text"
        },
        "owner": {
          "$ref": "#/$defs/text"
        },
        "scope": {
          "type": "object",
          "required": [
            "covers",
            "excludes"
          ],
          "additionalProperties": false,
          "properties": {
            "covers": {
              "$ref": "#/$defs/text"
            },
            "excludes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extensions in use, each defined in the project's README."
        },
        "environment": {
          "$ref": "#/$defs/text"
        },
        "review_interval_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "Evidence reference (section 8).",
      "required": [
        "locator",
        "kind",
        "claim",
        "observed_at",
        "applies_to"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "locator": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": [
            "implementation",
            "deployment",
            "test",
            "runtime_observation",
            "research",
            "measurement",
            "decision"
          ]
        },
        "claim": {
          "$ref": "#/$defs/text",
          "description": "The claim the evidence supports."
        },
        "observed_at": {
          "$ref": "#/$defs/date"
        },
        "applies_to": {
          "$ref": "#/$defs/text",
          "description": "Revision, release, environment or measurement period the evidence applies to."
        },
        "snapshot": {
          "type": "string",
          "description": "Immutable version or retained snapshot, when the locator is mutable."
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-z0-9-]+:[A-Za-z0-9+/=._-]+$",
          "description": "Content digest of what the locator points at, as <algorithm>:<value>, such as sha256:4f1c..."
        },
        "expires_at": {
          "$ref": "#/$defs/date",
          "description": "After this date the reference no longer supports its claim."
        }
      }
    },
    "authored-evidence": {
      "allOf": [
        {
          "$ref": "#/$defs/evidence"
        }
      ],
      "properties": {
        "kind": {
          "enum": [
            "research",
            "decision"
          ]
        }
      },
      "description": "Authored evidence on a record: research or decision (section 8). Observed evidence belongs in state."
    },
    "binding": {
      "type": "object",
      "minProperties": 1,
      "description": "What to observe in one source, such as a CI workflow and test path, or a service and environments."
    },
    "reference": {
      "type": "object",
      "description": "Implementation or operational reference. A proposed record may point at a planned one.",
      "required": [
        "locator"
      ],
      "additionalProperties": false,
      "properties": {
        "locator": {
          "$ref": "#/$defs/text"
        },
        "planned": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "record": {
      "type": "object",
      "description": "A record (sections 4 and 5). Type-specific content is required once a record is active; proposed records may be incomplete.",
      "required": [
        "id",
        "type",
        "name",
        "description",
        "owner",
        "lifecycle",
        "evidence",
        "last_reviewed_at"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "description": "A section 4 type, or a type a declared extension defines.",
          "anyOf": [
            {
              "enum": [
                "Outcome",
                "Capability",
                "Process",
                "Requirement",
                "Information",
                "Application",
                "Infrastructure",
                "Measure"
              ]
            },
            {
              "pattern": "^[a-z][a-z0-9-]*:[A-Z][A-Za-z]*$",
              "description": "Extension type, as <extension>:<Type>."
            }
          ]
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "owner": {
          "$ref": "#/$defs/text"
        },
        "lifecycle": {
          "enum": [
            "proposed",
            "active",
            "retired"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authored-evidence"
          }
        },
        "last_reviewed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "beneficiary": {
          "$ref": "#/$defs/text",
          "description": "Outcome: intended beneficiary."
        },
        "success_criterion": {
          "$ref": "#/$defs/text",
          "description": "Outcome: what counts as success."
        },
        "evaluation_period": {
          "$ref": "#/$defs/text",
          "description": "Outcome: period over which it is evaluated."
        },
        "scope": {
          "$ref": "#/$defs/text",
          "description": "Capability: scope of the ability and its boundaries."
        },
        "perspective": {
          "enum": [
            "customer",
            "business"
          ],
          "description": "Process: whose account it gives."
        },
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "description": "Process: who takes part."
        },
        "trigger": {
          "$ref": "#/$defs/text",
          "description": "Process: what starts it."
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "description": "Process: major steps, in order."
        },
        "completion": {
          "$ref": "#/$defs/text",
          "description": "Process: completion condition."
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "description": "Process: significant exceptions."
        },
        "statement": {
          "$ref": "#/$defs/text",
          "description": "Requirement: the verifiable behaviour or constraint."
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "description": "Requirement: each criterion checkable on its own. Edge cases (zero, off, empty, failure, retry, duplicate) belong here."
        },
        "verification_method": {
          "$ref": "#/$defs/text",
          "description": "Requirement: how it is verified."
        },
        "definition": {
          "$ref": "#/$defs/text",
          "description": "Information: what the concept means."
        },
        "identifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "description": "Information: key identifiers or properties, named exactly as other records and acceptance criteria refer to them."
        },
        "steward": {
          "$ref": "#/$defs/text",
          "description": "Information: who is responsible for it."
        },
        "responsibility": {
          "$ref": "#/$defs/text",
          "description": "Application: what it is responsible for."
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "description": "Application: interfaces or entry points."
        },
        "implementation_ref": {
          "$ref": "#/$defs/reference",
          "description": "Application: where it is implemented."
        },
        "kind": {
          "$ref": "#/$defs/text",
          "description": "Infrastructure: resource kind."
        },
        "purpose": {
          "$ref": "#/$defs/text",
          "description": "Infrastructure: what it is for."
        },
        "operational_ref": {
          "$ref": "#/$defs/reference",
          "description": "Infrastructure: where it is operated or configured."
        },
        "calculation": {
          "$ref": "#/$defs/text",
          "description": "Measure: how the value is calculated."
        },
        "unit": {
          "$ref": "#/$defs/text"
        },
        "population": {
          "$ref": "#/$defs/text"
        },
        "source": {
          "$ref": "#/$defs/text",
          "description": "Measure: collection source."
        },
        "cadence": {
          "$ref": "#/$defs/text"
        },
        "baseline": {
          "description": "Measure: the baseline value, or the string unknown (never zero for an unknown baseline).",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "baseline_owner": {
          "$ref": "#/$defs/text",
          "description": "Measure: who will collect an unknown baseline."
        },
        "baseline_action": {
          "$ref": "#/$defs/text",
          "description": "Measure: how an unknown baseline will be collected."
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "observe": {
          "type": "object",
          "description": "Bindings: where tooling observes this record (section 5). Each key is a source kind; its fields are defined by the tool that reads it.",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^(tests|deployments|runtime|measurement)$": {
              "$ref": "#/$defs/binding"
            },
            "^[a-z][a-z0-9-]*:[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/binding"
            }
          }
        },
        "observe_only": {
          "type": "boolean",
          "default": false,
          "description": "Reported on, never changed by this project (section 5)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Measure"
              },
              "baseline": {
                "const": "unknown"
              }
            },
            "required": [
              "type",
              "baseline"
            ]
          },
          "then": {
            "required": [
              "baseline_owner",
              "baseline_action"
            ]
          }
        },
        {
          "$ref": "#/$defs/active-content"
        }
      ]
    },
    "active-content": {
      "description": "Type-specific content each active record must carry (section 4).",
      "if": {
        "properties": {
          "lifecycle": {
            "const": "active"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "Outcome"
                }
              }
            },
            "then": {
              "required": [
                "beneficiary",
                "success_criterion",
                "evaluation_period"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "Capability"
                }
              }
            },
            "then": {
              "required": [
                "scope"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "Process"
                }
              }
            },
            "then": {
              "required": [
                "actors",
                "trigger",
                "steps",
                "completion",
                "exceptions"
              ],
              "properties": {
                "actors": {
                  "minItems": 1
                },
                "steps": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "Requirement"
                }
              }
            },
            "then": {
              "required": [
                "statement",
                "acceptance_criteria",
                "verification_method"
              ],
              "properties": {
                "acceptance_criteria": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "Information"
                }
              }
            },
            "then": {
              "required": [
                "definition",
                "identifiers",
                "steward"
              ],
              "properties": {
                "identifiers": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "Application"
                }
              }
            },
            "then": {
              "required": [
                "responsibility",
                "interfaces",
                "implementation_ref"
              ],
              "properties": {
                "interfaces": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "Infrastructure"
                }
              }
            },
            "then": {
              "required": [
                "kind",
                "purpose",
                "operational_ref"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "Measure"
                }
              }
            },
            "then": {
              "required": [
                "calculation",
                "unit",
                "population",
                "source",
                "cadence",
                "baseline",
                "target"
              ]
            }
          }
        ]
      }
    },
    "relationship": {
      "type": "object",
      "description": "A directed, typed relationship (section 6). Its identity is id, or the tuple (source, type, target).",
      "required": [
        "source",
        "type",
        "target"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "contributes_to",
                "uses_capability",
                "supports",
                "implements",
                "uses",
                "reads",
                "writes",
                "depends_on",
                "evaluates",
                "contains",
                "supersedes",
                "stores"
              ]
            },
            {
              "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9_]*$",
              "description": "Extension relationship, as <extension>:<name>."
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "rationale": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "conditions": {
          "type": "string",
          "description": "Required for a depends_on that is optional, asynchronous, or limited to specific operations."
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authored-evidence"
          }
        },
        "role": {
          "enum": [
            "system_of_record",
            "replica",
            "cache",
            "archive"
          ],
          "description": "For stores: the role of the copy the resource holds (section 6)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "stores"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "role"
            ]
          }
        }
      ]
    },
    "exception": {
      "type": "object",
      "description": "A documented exception to a rule (section 7).",
      "required": [
        "rule",
        "record",
        "reason",
        "owner",
        "expires_at"
      ],
      "additionalProperties": false,
      "properties": {
        "rule": {
          "$ref": "#/$defs/text",
          "description": "The rule waived, such as \"7.2\"."
        },
        "record": {
          "$ref": "#/$defs/id"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "owner": {
          "$ref": "#/$defs/text"
        },
        "expires_at": {
          "$ref": "#/$defs/date",
          "description": "Review or expiry date."
        }
      }
    }
  }
}
